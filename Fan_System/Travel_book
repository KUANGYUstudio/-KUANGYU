<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>青森・弘前 春日家族旅行</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700&display=swap');
        @import url('https://cdn.jsdelivr.net/npm/jf-openhuninn@1.1.2/jf-openhuninn-1.1.min.css');

        :root {
            --bg-color: #FFFCF6;
            --stroke-color: #3E3A39;
            --coral-pink: #F2A497;
            --yamabuki-yellow: #F6D27A;
            --water-blue: #A8D3E6;
            --wakatake-green: #B9DAA5;
            --border-width: 3px;
            --radius-large: 24px;
            --radius-small: 12px;
        }

        body {
            background-color: var(--bg-color);
            color: var(--stroke-color);
            font-family: 'jf-openhuninn-1.1', 'M PLUS Rounded 1c', sans-serif;
            margin: 0;
            padding: 0;
            padding-top: 70px;
            -webkit-font-smoothing: antialiased;
        }

        /* 頂端固定選單 */
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            background-color: var(--bg-color);
            border-bottom: var(--border-width) solid var(--stroke-color);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        
        .nav-links {
            display: flex;
            gap: 20px;
            font-weight: bold;
        }
        
        .nav-links a {
            text-decoration: none;
            color: var(--stroke-color);
            padding: 5px 10px;
            border-radius: var(--radius-small);
            transition: background-color 0.2s;
        }

        .nav-links a:hover {
            background-color: var(--yamabuki-yellow);
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        /* 卡片共用樣式 */
        .card {
            background-color: #FFFFFF;
            border: var(--border-width) solid var(--stroke-color);
            border-radius: var(--radius-large);
            padding: 20px;
            margin-bottom: 24px;
            box-shadow: 4px 4px 0px var(--stroke-color);
        }

        /* 首頁標題與倒數 */
        .hero {
            text-align: center;
            background-color: var(--water-blue);
        }

        .hero h1 {
            margin: 10px 0;
            font-size: 1.8rem;
        }

        .countdown {
            display: inline-block;
            background-color: #FFFFFF;
            border: var(--border-width) solid var(--stroke-color);
            border-radius: var(--radius-small);
            padding: 10px 20px;
            font-size: 1.2rem;
            font-weight: bold;
            margin-top: 10px;
        }

        /* 動畫 */
        .floating {
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .bounce {
            animation: bounceIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes bounceIn {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        @media (prefers-reduced-motion: reduce) {
            .floating, .bounce {
                animation: none !important;
                transform: none !important;
                opacity: 1 !important;
            }
        }

        /* 標籤 */
        .tag {
            display: inline-block;
            border: var(--border-width) solid var(--stroke-color);
            border-radius: 8px;
            padding: 2px 8px;
            font-size: 0.8rem;
            font-weight: bold;
            margin-right: 8px;
        }
        
        .tag-must { background-color: var(--coral-pink); }
        .tag-train { background-color: var(--wakatake-green); }
        .tag-flight { background-color: var(--water-blue); }

        /* 行程切換 */
        .tabs {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }
        
        .tabs::-webkit-scrollbar { display: none; }
        
        .tab-btn {
            background-color: #FFFFFF;
            border: var(--border-width) solid var(--stroke-color);
            border-radius: var(--radius-small);
            padding: 10px 16px;
            font-weight: bold;
            font-family: inherit;
            cursor: pointer;
            white-space: nowrap;
        }
        
        .tab-btn.active {
            background-color: var(--yamabuki-yellow);
            transform: translateY(-2px);
            box-shadow: 2px 2px 0px var(--stroke-color);
        }

        /* 時間軸 */
        .day-content {
            display: none;
        }
        
        .day-content.active {
            display: block;
        }

        .timeline-item {
            display: flex;
            margin-bottom: 20px;
            position: relative;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: 48px;
            top: 30px;
            bottom: -20px;
            width: var(--border-width);
            background-color: var(--stroke-color);
        }

        .timeline-item:last-child::before {
            display: none;
        }

        .time {
            width: 50px;
            font-weight: bold;
            flex-shrink: 0;
            padding-top: 5px;
        }

        .dot {
            width: 14px;
            height: 14px;
            background-color: var(--bg-color);
            border: var(--border-width) solid var(--stroke-color);
            border-radius: 50%;
            margin: 7px 15px 0 0;
            position: relative;
            z-index: 2;
        }

        .event {
            flex-grow: 1;
            background-color: var(--bg-color);
            border: var(--border-width) solid var(--stroke-color);
            border-radius: var(--radius-small);
            padding: 12px;
        }
        
        .event h3 {
            margin: 0 0 8px 0;
            font-size: 1.1rem;
        }
        
        .event p {
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* 待辦清單 */
        .todo-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .todo-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            cursor: pointer;
        }

        .checkbox {
            width: 20px;
            height: 20px;
            border: var(--border-width) solid var(--stroke-color);
            border-radius: 6px;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #FFFFFF;
            transition: background-color 0.2s;
        }

        .todo-item.done .checkbox {
            background-color: var(--wakatake-green);
        }
        
        .todo-item.done .checkbox::after {
            content: '✓';
            color: var(--stroke-color);
            font-weight: bold;
        }

        .todo-item.done span {
            text-decoration: line-through;
            opacity: 0.7;
        }

        .svg-container {
            display: flex;
            justify-content: center;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <header>
        <div class="nav-links">
            <a href="#itinerary">行程</a>
            <a href="#flight">航班</a>
            <a href="#hotel">住宿</a>
            <a href="#todo">準備清單</a>
        </div>
    </header>

    <div class="container">
        <!-- 首頁標題與倒數 -->
        <div class="card hero">
            <div class="svg-container floating">
                <!-- 櫻花與新幹線插圖 SVG -->
                <svg width="120" height="80" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10,60 L110,60" stroke="#3E3A39" stroke-width="3" stroke-linecap="round"/>
                    <path d="M20,60 C20,30 40,20 80,20 L100,20 C110,20 115,30 115,60 Z" fill="#B9DAA5" stroke="#3E3A39" stroke-width="3"/>
                    <rect x="35" y="30" width="20" height="15" rx="4" fill="#FFFCF6" stroke="#3E3A39" stroke-width="3"/>
                    <rect x="65" y="30" width="20" height="15" rx="4" fill="#FFFCF6" stroke="#3E3A39" stroke-width="3"/>
                    <circle cx="20" cy="15" r="10" fill="#F2A497" stroke="#3E3A39" stroke-width="3"/>
                    <circle cx="100" cy="10" r="8" fill="#F2A497" stroke="#3E3A39" stroke-width="3"/>
                </svg>
            </div>
            <h1>青森・弘前 春日家族旅行</h1>
            <p>與媽媽、Mike 的賞櫻與新幹線之旅</p>
            <div class="countdown" id="countdown-timer">計算中...</div>
        </div>

        <!-- 航班資訊 -->
        <div id="flight" class="card" style="background-color: var(--yamabuki-yellow);">
            <div class="svg-container">
                <!-- 飛機插圖 SVG -->
                <svg width="60" height="40" viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10,25 C10,15 20,10 40,10 L55,10 C58,10 58,20 55,25 Z" fill="#FFFFFF" stroke="#3E3A39" stroke-width="3"/>
                    <path d="M25,15 L35,5 L40,5 L35,15" fill="#FFFFFF" stroke="#3E3A39" stroke-width="3"/>
                    <path d="M20,25 L30,35 L35,35 L30,25" fill="#FFFFFF" stroke="#3E3A39" stroke-width="3"/>
                </svg>
            </div>
            <h2 style="text-align: center; margin-top:0;">航班資訊</h2>
            <p><span class="tag tag-flight">去程</span> 台北 (TPE) 飛往 函館 (HKD)</p>
            <p><span class="tag tag-flight">回程</span> 青森 (AOJ) 或 函館 飛往 台北</p>
        </div>

        <!-- 每日行程 -->
        <div id="itinerary" class="card">
            <h2>行程總覽</h2>
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab(1)">Day 1</button>
                <button class="tab-btn" onclick="switchTab(2)">Day 2</button>
                <button class="tab-btn" onclick="switchTab(3)">Day 3</button>
                <button class="tab-btn" onclick="switchTab(4)">Day 4</button>
                <button class="tab-btn" onclick="switchTab(5)">Day 5</button>
            </div>

            <div id="day1" class="day-content active">
                <div class="timeline-item">
                    <div class="time">13:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3>抵達函館</h3>
                        <p>辦理入境手續，前往市區飯店寄放行李。</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="time">17:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3><span class="tag tag-must">必去</span> 函館山百萬夜景</h3>
                        <p>搭乘纜車上山，欣賞經典的海灣夜景。</p>
                    </div>
                </div>
            </div>

            <div id="day2" class="day-content">
                <div class="timeline-item">
                    <div class="time">08:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3>函館朝市</h3>
                        <p>與媽媽和 Mike 一起品嚐新鮮海產與朝市早餐。</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="time">11:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3><span class="tag tag-train">新幹線</span> 穿越青函隧道</h3>
                        <p>搭乘北海道新幹線由函館前往新青森站。</p>
                    </div>
                </div>
            </div>

            <div id="day3" class="day-content">
                <div class="timeline-item">
                    <div class="time">09:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3><span class="tag tag-train">JR</span> 抵達弘前</h3>
                        <p>轉乘前往弘前市區。</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="time">11:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3><span class="tag tag-must">必去</span> 弘前城賞櫻</h3>
                        <p>欣賞著名的櫻花祭與花筏美景，並在周邊品嚐蘋果派。</p>
                    </div>
                </div>
            </div>

            <div id="day4" class="day-content">
                <div class="timeline-item">
                    <div class="time">10:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3>青森市區觀光</h3>
                        <p>參觀睡魔之家 Wa Rasse，感受傳統祭典震撼。</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="time">14:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3>A-FACTORY 採買</h3>
                        <p>購買蘋果酒與青森在地特色伴手禮。</p>
                    </div>
                </div>
            </div>

            <div id="day5" class="day-content">
                <div class="timeline-item">
                    <div class="time">10:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3>市區早茶與行李打包</h3>
                        <p>享用最後的日式早餐，確認行李重量。</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="time">13:00</div>
                    <div class="dot"></div>
                    <div class="event">
                        <h3><span class="tag tag-flight">回程</span> 前往機場</h3>
                        <p>搭乘班機返回台北，結束美好的家族旅行。</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 住宿資訊 -->
        <div id="hotel" class="card" style="background-color: var(--water-blue);">
            <h2>住宿資訊</h2>
            <p><strong>函館住宿：</strong> 預計安排車站周邊，方便移動。</p>
            <p><strong>青森住宿：</strong> 安排於新青森或青森車站附近，便於搭乘新幹線與前往弘前。</p>
        </div>

        <!-- 待辦清單 -->
        <div id="todo" class="card" style="background-color: var(--coral-pink);">
            <h2>出發前準備</h2>
            <ul class="todo-list">
                <li class="todo-item" onclick="toggleTodo(this)">
                    <div class="checkbox"></div>
                    <span>確認媽媽的護照效期</span>
                </li>
                <li class="todo-item" onclick="toggleTodo(this)">
                    <div class="checkbox"></div>
                    <span>預訂北海道新幹線車票</span>
                </li>
                <li class="todo-item" onclick="toggleTodo(this)">
                    <div class="checkbox"></div>
                    <span>打包防風與保暖衣物</span>
                </li>
                <li class="todo-item" onclick="toggleTodo(this)">
                    <div class="checkbox"></div>
                    <span>幫 Mike 確認攝影器材與電池</span>
                </li>
                <li class="todo-item" onclick="toggleTodo(this)">
                    <div class="checkbox"></div>
                    <span>預訂弘前城周邊餐廳</span>
                </li>
            </ul>
        </div>
    </div>

    <script>
        // 設定出發日期 (2027年4月)
        const targetDate = new Date('2027-04-10T00:00:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                document.getElementById("countdown-timer").innerText = "出發囉！";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            document.getElementById("countdown-timer").innerText = `距離出發還有 ${days} 天`;
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // 行程標籤切換與動畫
        function switchTab(dayIndex) {
            document.querySelectorAll('.tab-btn').forEach((btn, index) => {
                if (index + 1 === dayIndex) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            document.querySelectorAll('.day-content').forEach((content, index) => {
                if (index + 1 === dayIndex) {
                    content.classList.add('active');
                    
                    // 重置動畫，確保支援減少動態效果設定時不會出錯
                    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        content.classList.remove('bounce');
                        void content.offsetWidth; // 觸發 reflow 重繪
                        content.classList.add('bounce');
                    }
                } else {
                    content.classList.remove('active');
                    content.classList.remove('bounce');
                }
            });
        }

        // 待辦事項打勾
        function toggleTodo(element) {
            element.classList.toggle('done');
        }
    </script>
</body>
</html>
