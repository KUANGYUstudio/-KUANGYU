<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>配速表產生器</title>
    <!-- 引入 html2canvas 處理網頁截圖存檔 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, 'Microsoft JhengHei', sans-serif;
            display: flex;
            gap: 40px;
            padding: 20px;
            background-color: #f5f5f5;
            color: #333;
        }
        .controls {
            width: 450px;
            background: #fff;
            padding: 20px;
            border: 1px solid #ddd;
        }
        .preview-area {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .settings-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #eee;
        }
        .settings-group label {
            font-size: 12px;
            display: flex;
            flex-direction: column;
        }
        .settings-group input {
            width: 60px;
            padding: 4px;
            margin-top: 4px;
        }
        .row-entry {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1fr auto auto;
            gap: 5px;
            margin-bottom: 10px;
            align-items: center;
        }
        .row-entry input[type="text"] {
            width: 100%;
            padding: 4px;
            box-sizing: border-box;
        }
        button {
            background-color: #333;
            color: #fff;
            border: none;
            padding: 8px 12px;
            cursor: pointer;
            margin-top: 10px;
        }
        button:hover { background-color: #555; }
        
        /* 預覽區塊設定 */
        #render-container {
            background: #fff;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            border: 1px dashed #ccc;
            padding: 10px;
        }
        #pacing-table {
            border-collapse: collapse;
            border: 1px solid #000;
            box-sizing: border-box;
            background-color: #fff;
        }
        #pacing-table .station-cell {
            border: 1px solid #000;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-sizing: border-box;
        }
        #pacing-table .row:nth-child(even) .station-cell {
            background-color: #f2f2f2;
        }
        .cell-top, .cell-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2px 8px;
            flex: 1;
        }
        .cell-bottom {
            border-top: 1px dotted #ccc;
        }
        .station-name { font-weight: bold; font-size: 15px; display: flex; align-items: center; gap: 4px; }
        .val-total-km { font-size: 14px; }
        .val-int-km { font-size: 14px; }
        .val-time { font-weight: bold; font-size: 15px; }
        .unit { font-size: 10px; font-weight: normal; margin-left: 2px; }
    </style>
</head>
<body>

    <div class="controls">
        <h3>版面設定</h3>
        <div class="settings-group">
            <label>寬度 (公分)<input type="number" id="tb-width" value="4.5" step="0.1"></label>
            <label>高度 (公分)<input type="number" id="tb-height" value="14" step="0.5"></label>
        </div>

        <h3>站點資料</h3>
        <div id="rows-container"></div>
        
        <button onclick="addRow()">+ 新增站點</button>
        <button onclick="generateTable()">更新預覽</button>
        <button onclick="exportImage()" style="background-color: #2b78e4; width: 100%;">下載為圖片</button>
    </div>

    <div class="preview-area">
        <h3>預覽區</h3>
        <div id="render-container">
            <div id="pacing-table"></div>
        </div>
    </div>

<script>
    // 預設資料 (參考截圖)
    let stations = [
        { name: "人止關", totalKm: "16.1", intKm: "16", time: "35", supply: false },
        { name: "霧社", totalKm: "21.4", intKm: "5", time: "21", supply: true },
        { name: "見晴", totalKm: "28.4", intKm: "7", time: "35", supply: false },
        { name: "清境小七", totalKm: "33.4", intKm: "5", time: "20", supply: false },
        { name: "翠峰", totalKm: "39.4", intKm: "6", time: "24", supply: true },
        { name: "鳶峰", totalKm: "46.0", intKm: "6.6", time: "36", supply: false },
        { name: "昆陽", totalKm: "51.2", intKm: "5", time: "26", supply: false },
        { name: "武嶺", totalKm: "53.3", intKm: "2", time: "13", supply: false }
    ];

    // 水滴圖示 (使用 SVG，避免相容性與格式問題)
    const svgWaterDrop = `<svg width="14" height="14" viewBox="0 0 24 24"><path fill="#4fc3f7" d="M12,21c-3.3,0-6-2.7-6-6c0-4,6-11,6-11s6,7,6,11C18,18.3,15.3,21,12,21z"/></svg>`;

    function renderInputs() {
        const container = document.getElementById("rows-container");
        container.innerHTML = "";
        stations.forEach((st, idx) => {
            container.innerHTML += `
                <div class="row-entry">
                    <input type="text" value="${st.name}" placeholder="名稱" onchange="updateData(${idx}, 'name', this.value)">
                    <input type="text" value="${st.totalKm}" placeholder="總里程" onchange="updateData(${idx}, 'totalKm', this.value)">
                    <input type="text" value="${st.intKm}" placeholder="段里程" onchange="updateData(${idx}, 'intKm', this.value)">
                    <input type="text" value="${st.time}" placeholder="時間(分)" onchange="updateData(${idx}, 'time', this.value)">
                    <label style="font-size:12px;"><input type="checkbox" ${st.supply ? 'checked' : ''} onchange="updateData(${idx}, 'supply', this.checked)">補給</label>
                    <button onclick="removeRow(${idx})" style="margin:0; padding:2px 6px; background:#cc0000;">X</button>
                </div>
            `;
        });
    }

    function updateData(idx, field, value) {
        stations[idx][field] = value;
    }

    function addRow() {
        stations.push({ name: "", totalKm: "", intKm: "", time: "", supply: false });
        renderInputs();
    }

    function removeRow(idx) {
        stations.splice(idx, 1);
        renderInputs();
        generateTable();
    }

    function generateTable() {
        const widthCm = document.getElementById("tb-width").value;
        const heightCm = document.getElementById("tb-height").value;
        const table = document.getElementById("pacing-table");
        
        // 1公分約為 37.8 像素，做適當放大以確保清晰度
        const pxPerCm = 37.8 * 1.5; 
        table.style.width = (widthCm * pxPerCm) + "px";
        table.style.height = (heightCm * pxPerCm) + "px";
        
        table.innerHTML = "";
        
        const rowHeightPercent = 100 / stations.length;

        stations.forEach(st => {
            const supplyIcon = st.supply ? svgWaterDrop : "";
            const rowHtml = `
                <div class="row" style="height: ${rowHeightPercent}%;">
                    <div class="station-cell" style="height: 100%;">
                        <div class="cell-top">
                            <span class="station-name">${st.name} ${supplyIcon}</span>
                            <span class="val-total-km">${st.totalKm}<span class="unit">k</span></span>
                        </div>
                        <div class="cell-bottom">
                            <span class="val-int-km">${st.intKm}<span class="unit">k</span></span>
                            <span class="val-time">${st.time}<span class="unit">min</span></span>
                        </div>
                    </div>
                </div>
            `;
            table.innerHTML += rowHtml;
        });
    }

    function exportImage() {
        generateTable(); // 確保資料為最新
        const tableNode = document.getElementById("pacing-table");
        
        html2canvas(tableNode, { scale: 3 }).then(canvas => {
            const link = document.createElement('a');
            link.download = 'pacing_table.png';
            link.href = canvas.toDataURL("image/png");
            link.click();
        });
    }

    // 初始化
    renderInputs();
    generateTable();
</script>

</body>
</html>
